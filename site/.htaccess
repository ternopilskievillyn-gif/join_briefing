Options -Indexes DirectoryIndex index.html AddDefaultCharset UTF-8

<IfModule mod_deflate.c> AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml </IfModule>

<IfModule mod_expires.c>
  ExpiresActive On ExpiresByType text/html "access plus 0 seconds" ExpiresByType text/css "access plus 7 days" ExpiresByType
  application/javascript "access plus 7 days" ExpiresByType image/png "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff" Header set Referrer-Policy "strict-origin-when-cross-origin" Header set X-Frame-Options
  "SAMEORIGIN"
</IfModule>
